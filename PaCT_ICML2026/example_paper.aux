\newlabel{sec:perturbation_analysis}{{3.9}{8}{}{subsection.3.9}{}}
\newlabel{sec:perturbation_analysis@cref}{{[subsection][9][3]3.9}{[1][8][]8}}
\citation{hao2024training}
\newlabel{fig:attention_heatmap}{{8}{9}{\textbf {Cross-attention weight distribution across different number of context tokens.} Position 0 denotes the \textbf {last} token before latent synthesis, position 1 the \textbf {second-to-last}, and so on. The model concentrates attention on the most recent 1--2 positions regardless of available context.\relax }{figure.caption.14}{}}
\newlabel{fig:attention_heatmap@cref}{{[figure][8][]8}{[1][8][]9}}
\newlabel{tab:latent_perturbation}{{7}{9}{\textbf {Perturbing PaCT's latent reasoning states on GSM8k.} Destructive interventions (zeroing, random-norm replacement, cross-example swap) collapse accuracy, while structure-preserving Gaussian noise is largely absorbed. Restricting answer decoding to attend only to latent states (no-prompt decode) also collapses accuracy, indicating that the latents encode information not redundantly present in the prompt.\relax }{table.caption.15}{}}
\newlabel{tab:latent_perturbation@cref}{{[table][7][]7}{[1][9][]9}}
\newlabel{tab:ood_transfer}{{8}{9}{\textbf {Out-of-distribution generalization.} All models are trained on GSM8k and evaluated zero-shot on three held-out math benchmarks. PaCT matches or exceeds Coconut on every split.\relax }{table.caption.16}{}}
\newlabel{tab:ood_transfer@cref}{{[table][8][]8}{[1][9][]9}}
